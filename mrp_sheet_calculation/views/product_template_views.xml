<odoo>
  <record id="product_template_form_sheet_fields" model="ir.ui.view">
    <field name="name">product.template.form.sheet.fields</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='inventory']" position="inside">
        <group string="Sheet Configuration" name="sheet_configuration">
          <group>
            <field name="sheet_length" />
            <field name="sheet_width" />
          </group>
          <group>
            <field name="gsm" />
            <field name="productivity" />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>