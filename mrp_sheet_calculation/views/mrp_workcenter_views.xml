<odoo>
  <record id="mrp_workcenter_form_input_output_uom" model="ir.ui.view">
    <field name="name">mrp.workcenter.form.input.output.uom</field>
    <field name="model">mrp.workcenter</field>
    <field name="inherit_id" ref="mrp.mrp_workcenter_view" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='capacity']" position="inside">
        <field name="qty_in_uom" />
        <field name="qty_out_uom" />
      </xpath>
    </field>
  </record>
</odoo>
