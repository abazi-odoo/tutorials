<odoo>
    <record id="view_a_then_b_list" model="ir.ui.view">
        <field name="name">field.playground.a_then_b.list</field>
        <field name="model">field.playground.a_then_b</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="description"/><field name="value"/><field name="currency_id"/></list>
        </field>
    </record>
    <record id="view_b_then_a_list" model="ir.ui.view">
        <field name="name">field.playground.b_then_a.list</field>
        <field name="model">field.playground.b_then_a</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="description"/><field name="value"/><field name="currency_id"/></list>
        </field>
    </record>
    <record id="view_explicit_list" model="ir.ui.view">
        <field name="name">field.playground.explicit.list</field>
        <field name="model">field.playground.explicit</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="description"/><field name="value"/><field name="currency_id"/></list>
        </field>
    </record>

    <record id="action_a_then_b" model="ir.actions.act_window">
        <field name="name">A then B (Monetary first)</field>
        <field name="res_model">field.playground.a_then_b</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_b_then_a" model="ir.actions.act_window">
        <field name="name">B then A (Float first)</field>
        <field name="res_model">field.playground.b_then_a</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_explicit" model="ir.actions.act_window">
        <field name="name">Explicit Float override</field>
        <field name="res_model">field.playground.explicit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_field_playground_root" name="Field Type Playground" sequence="90"/>
    <menuitem id="menu_a_then_b" parent="menu_field_playground_root" action="action_a_then_b" sequence="10"/>
    <menuitem id="menu_b_then_a" parent="menu_field_playground_root" action="action_b_then_a" sequence="20"/>
    <menuitem id="menu_explicit" parent="menu_field_playground_root" action="action_explicit" sequence="30"/>
</odoo>
